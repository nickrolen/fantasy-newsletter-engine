# Live league state, like ROSTERS.json.
data/IL_SLOTS.json
config/RECORDS.json

# --------------------------------------------
# Integrity baseline (machine-specific)
# --------------------------------------------
config/.file_baselines.json

# --------------------------------------------
# Historical Data -- TRACKED ON PURPOSE
# --------------------------------------------
# data/historical/ is the permanent, append-only record: nine-plus seasons of
# standings, matchups, drafts, trades, and per-game player logs. It is NOT
# regenerable in practice -- Yahoo's API is the only upstream source, old
# league keys go stale, and the season reset truncates the working PLAYERLOG.
# These files are committed so the record has offsite, versioned backup.
# Do not re-ignore them without arranging another backup first.
#
# (Rolling backups are still ignored -- see "Large backup files" below.)

# --------------------------------------------
# Keep These in Repo (Templates/Config)
# --------------------------------------------
# !data/PLAYERLIST.xlsx        # Player projections - keep if sharing
# !config/SCHEDULE.json        # League schedule structure - keep
# !config/INJURY_OVERRIDES.json # Can keep as example
# !data/nba_schedule_*.json    # NBA schedule - keep
# !templates/newsletter_template.md # Template - definitely keep
# !*.example                   # Example files - keep

# --------------------------------------------
# Logs and Temp Files
# --------------------------------------------
*.log
*.tmp
*.temp
*.cache
.cache/
.pytest_cache/
pytest-cache-files-*/

# --------------------------------------------
# Jupyter Notebooks (if any)

# --------------------------------------------
# Large backup files
# --------------------------------------------
data/historical/*_BACKUP.json
data/historical/*_BACKUP.xlsx

# Script-written safety backups (rollup, rollover, h2h repair)
*.bak
*.preRestore

# --------------------------------------------
# Cowork backup directory
# --------------------------------------------
_backups/

# Review/repair artifacts (not part of the engine)
PROJECT_REVIEW_REPORT.html
THESIS_DEFENSE_REPORT.html
_recovery/

# State-migration archive (contains credentials -- never commit)
newsletter_state.zip

# --------------------------------------------
# League lore (10-07). The repository is public; lore is the league's
# private mythology. Never commit. (No chat logs, ever: not even ignored.)
# --------------------------------------------
config/LEAGUE_LORE.json
# The usage ledger is a list of lore entry ids (myth-benton-blunders,
# loyalty-nick-anthonydavis). The repo is public and the lore file is not;
# a bare id gives the entry away just as a tag in the page source would.
config/LORE_USAGE.json
data/lore_backups/
output/claim_check_week*.md
output/advice_preview_week*.html
output/angles_week*.json
output/angles_*.md
output/lore_for_drafting.json

# Dry-run packets: they carry the lore export, which never reaches git
output/dryrun/

# Staged read-only copy for an external audit. Credentials and output/dryrun
# are excluded from it; see claude/AUDIT_BRIEF. Delete after the audit.
_audit_export/

# Live as-of lines. The .json is regenerable output; the .state.json is NOT --
# it records the week-opening tag baseline and seed, and can only be taken
# once, on the first day. Since P2 (10-31) it and the week's tag log
# (live_lines_weekN.tag_log.jsonl) are league state: kept in the private repo
# (config/STATE_MANIFEST.json), not committed here.
output/live_lines_week*.json
output/live_lines_week*.tag_log.jsonl
# B3: the midnight refresh service's run log and captured console.
output/refresh_service.*

# Staging area for files a builder session could not delete (device_bash cannot
# rm inside a connected folder). On 2026-10-28 a bundle left here for a timing
# run held config/LEAGUE_LORE.json and the lore backups -- gitignored files, in
# a tarball git would have staged on "git add -A", in a public repo.
_to_delete/
*.tgz

# keepability v3: the step A hits table the fit report reads (scripts/keeper_backtest.py --json)
output/keeper_backtest.json

# --------------------------------------------
# League state -> the private repo nickrolen/newsletter-state (P2, 2026-10-31).
# config/STATE_MANIFEST.json is the list of what is state; scripts/state.py
# pull|push moves it between this folder and the private clone in .state/.
# These were tracked until 10-31 and were untracked with `git rm --cached`
# (the files stay on disk). What was already public stays public: history is
# not rewritten. tests/test_state_manifest.py pins that every manifest path is
# ignored here and tracked by nothing.
# --------------------------------------------
# the private clone and the per-machine sync record
.state/
.state_sync.json
config/INJURY_OVERRIDES.json
config/TRANSACTION_RULINGS.json
config/TRADES.json
config/RECENT_CONTENT.json
config/LAST_WEEK_RECAP.md
config/POTW_HISTORY.json
data/PLAYERLIST.xlsx
data/calibration/published_lines.json
data/keepability/
# Weekly snapshots and point-in-time captures. The pinned pre-season
# durability prior stays tracked and public (Nick, 10-31): league_config's
# durability_prior.snapshot, read by the public CI's integrity check.
config/snapshots/*
!config/snapshots/PLAYERLIST_2026-10-13.xlsx
# Past seasons' state, archived by start_new_season at the reset.
archive/
# The issues and their previews (STATUS task 26).
output/WEEK*_NEWSLETTER*.html
# Every title-odds run, kept as history and never scored (step 1a, 10-31).
output/title_odds_history.jsonl
# Nick's weekly context input in config/ (format_stats_report reads it there
# too), and an optional legacy league-history file data_loader reads if present.
config/weeklycontextinput_week*.json
data/LEAGUE_HISTORY_DETAILED.json
# Each week's live-line page. Week 1's two pages stay tracked and public on
# purpose (Nick, 10-31): output/live_lines_week1.html and
# output/live_lines_week1_midweek_DEMO.html.
output/live_lines_week*.html

# Step 1b, the hub (2026-11-02). League state (config/STATE_MANIFEST.json):
# the player-actuals cache, the hub payload, and the newsletter archive.
data/player_actuals.json
output/hub_state.json
output/hub_archive/
# Regenerable, never state: the plaintext preview (never published) and the
# publish directory (encrypted files only; step 1c publishes it).
output/hub_preview.html
output/hub_publish/
# Step 1c, the nightly run (2026-11-03). League state (config/STATE_MANIFEST.json):
# the run record, the transaction log, the latest title-odds run, the stakes,
# the tag records, each week's closing line, and update_leaguehistory's
# applied-weeks ledger (tracked until now; untracked with git rm --cached,
# history not rewritten).
output/nightly_runs.jsonl
data/transaction_log.jsonl
output/title_odds_latest.json
output/stakes.json
output/tag_records.jsonl
output/closing_line_week*.json
config/.leaguehistory_applied_weeks.json
# Step 1c-ii (2026-11-03): a week recorded as having no closing line (state),
# and state_overlay.py's marker on a runner's checkout (never state).
output/closing_none_week*.json
.state_overlay.json

# Player ages (moved to league state 11-03): every fetch_playerlist run rewrites
# it, the nightly one included, so it lives in the private repo with the rest.
config/PLAYER_AGES.json

# The night's marker (11-05): league state, written by every nightly-mode run.
output/nightly_last.json

# The hub's salt (11-05): league state; a new one makes every phone ask for the passphrase again.
output/hub_salt.json

# The move ledger (step 2, 11-05): league state. The entries (written only by
# scripts/ledger.py), what verification found (the nightly run), and each
# Monday window's checklist.
config/MOVE_LEDGER.json
data/move_ledger_states.jsonl
output/move_checklist_week*.json

# The filled drafting prompts (task 10a, 11-05): league state, they hold
# managers, team names and rosters (scripts/prepare_prompts.py).
output/prompts_week*.md
# the refetched NBA schedule: league state, in the private repo (task 33)
data/nba_schedule_*.refetched.json
